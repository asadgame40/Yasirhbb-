const TelegramBot = require("node-telegram-bot-api");
const fs = require("fs");
const path = require("path");

const TOKEN = process.env.BOT_TOKEN;
const OWNER = "6714164629";
const CHANNEL = "@Qaanciye";
const SUPPORT = "@Mrbosstiger";

if (!TOKEN) {
  console.error("9111277427:AAGWDI3sauGzZLykWrcBu4DA2-hIKKEoJ-A");
  process.exit(1);
}

const bot = new TelegramBot(TOKEN, { polling: true });

const DB_FILE = path.join(__dirname, "database.json");

let db = {
  films: [],
  dramas: [],
  users: [],
  admins: [OWNER]
};

function loadDB() {
  try {
    if (fs.existsSync(DB_FILE)) {
      const data = JSON.parse(fs.readFileSync(DB_FILE, "utf8"));
      db = {
        films: Array.isArray(data.films) ? data.films : [],
        dramas: Array.isArray(data.dramas) ? data.dramas : [],
        users: Array.isArray(data.users) ? data.users : [],
        admins: Array.isArray(data.admins) ? data.admins : [OWNER]
      };
    }
  } catch (e) {
    console.error("Database error:", e.message);
  }

  if (!db.admins.includes(OWNER)) db.admins.push(OWNER);
}

function saveDB() {
  const temp = DB_FILE + ".tmp";
  fs.writeFileSync(temp, JSON.stringify(db, null, 2));
  fs.renameSync(temp, DB_FILE);
}

loadDB();

const waiting = new Map();

function isAdmin(id) {
  return db.admins.includes(String(id));
}

function addUser(user) {
  const id = String(user.id);

  if (!db.users.some(u => String(u.id) === id)) {
    db.users.push({
      id,
      name: user.first_name || "User",
      username: user.username || "",
      joined: new Date().toISOString()
    });
    saveDB();
  }
}

function normalize(text) {
  return String(text || "")
    .toLowerCase()
    .normalize("NFKC")
    .replace(/[^\p{L}\p{N}]/gu, "");
}

function send(chatId, text) {
  return bot.sendMessage(chatId, text, {
    parse_mode: "HTML"
  });
}

function menu() {
  return `🎬 <b>KU SOO DHAWOOW QAANCIYE FILM BOT PRO!</b>

👋 Soo dhowow!

🎞 /films - Liiska filimada
📺 /dramas - Liiska musalsallada
🔎 /movie MAGACA - Raadi filim
📚 /drama MAGACA - Raadi musalsal

👤 /register - Isdiiwaangeli
👑 /admin - Maamulka

📢 Channel: ${CHANNEL}
🛠 Support: ${SUPPORT}`;
}

function adminPanel() {
  return `👑 <b>QAANCIYE ADMIN PANEL</b>

🎬 /addfilm
📺 /adddrama
🗑 /deletefilm MAGAC
🗑 /deletedrama MAGAC

👥 /users
➕ /addadmin ID
➖ /deladmin ID

📋 /listfilms
📋 /listdramas
📊 /stats
📢 /broadcast QORAAL

❌ /cancel`;
}

async function sendMedia(chatId, item, type) {
  const caption =
    `${type === "film" ? "🎬" : "📺"} ${item.title}\n\n` +
    `QAANCIYE FILM BOT PRO\n${CHANNEL}`;

  return bot.sendVideo(chatId, item.file_id, {
    caption,
    protect_content: true
  });
}

/* START */

bot.onText(/^\/start$/, msg => {
  addUser(msg.from);
  send(msg.chat.id, menu());
});

/* REGISTER */

bot.onText(/^\/register$/, msg => {
  addUser(msg.from);
  send(msg.chat.id, "✅ Waad ka diiwaangashan tahay QAANCIYE FILM BOT PRO.");
});

/* ADMIN */

bot.onText(/^\/admin$/, msg => {
  if (!isAdmin(msg.from.id)) {
    return send(msg.chat.id, "⛔ Ma lihid awoodda maamulka.");
  }

  send(msg.chat.id, adminPanel());
});

/* CANCEL */

bot.onText(/^\/cancel$/, msg => {
  waiting.delete(String(msg.from.id));
  send(msg.chat.id, "❌ Hawsha waa la joojiyay.");
});

/* ADD FILM */

bot.onText(/^\/addfilm$/, msg => {
  if (!isAdmin(msg.from.id)) return send(msg.chat.id, "⛔ Admin kaliya.");

  waiting.set(String(msg.from.id), "film");
  send(msg.chat.id,
    "🎬 Soo dir VIDEO-ga filimka.\n\nCaption-ka ku qor magaca filimka.\n/cancel si aad u joojiso.");
});

/* ADD DRAMA */

bot.onText(/^\/adddrama$/, msg => {
  if (!isAdmin(msg.from.id)) return send(msg.chat.id, "⛔ Admin kaliya.");

  waiting.set(String(msg.from.id), "drama");
  send(msg.chat.id,
    "📺 Soo dir VIDEO-ga musalsalka.\n\nCaption-ka ku qor magaca.\n/cancel si aad u joojiso.");
});

/* RECEIVE VIDEO */

bot.on("message", async msg => {
  if (!msg.from) return;

  addUser(msg.from);

  const id = String(msg.from.id);
  const task = waiting.get(id);

  if (!task || !isAdmin(id)) return;
  if (!msg.video) return;

  const title = String(msg.caption || "").trim();

  if (!title) {
    return send(msg.chat.id, "❌ Video-ga caption ugu qor magaca.");
  }

  const list = task === "film" ? db.films : db.dramas;

  list.push({
    title,
    file_id: msg.video.file_id,
    added_by: id,
    date: new Date().toISOString()
  });

  saveDB();
  waiting.delete(id);

  send(msg.chat.id,
    `✅ <b>WAA LA KAYDIYAY!</b>\n\nMagac: ${title}\nNooc: ${task}`);
});

/* FILM LIST */

bot.onText(/^\/films$/, msg => {
  if (!db.films.length) {
    return send(msg.chat.id, "📭 Filim lama hayo.");
  }

  const text = db.films.map((f, i) =>
    `${i + 1}. ${f.title}`
  ).join("\n");

  send(msg.chat.id, "🎬 <b>FILMS LIST</b>\n\n" + text);
});

/* DRAMA LIST */

bot.onText(/^\/dramas$/, msg => {
  if (!db.dramas.length) {
    return send(msg.chat.id, "📭 Musalsal lama hayo.");
  }

  const text = db.dramas.map((d, i) =>
    `${i + 1}. ${d.title}`
  ).join("\n");

  send(msg.chat.id, "📺 <b>DRAMA LIST</b>\n\n" + text);
});

/* SEARCH FILM */

bot.onText(/^\/movie(?:\s+(.+))?$/i, async (msg, match) => {
  const query = (match[1] || "").trim();

  if (!query) {
    return send(msg.chat.id, "Isticmaal: /movie MAGACA");
  }

  const item = db.films.find(f =>
    normalize(f.title) === normalize(query)
  );

  if (!item) {
    return send(msg.chat.id, "❌ Filimkan lama helin.");
  }

  try {
    await sendMedia(msg.chat.id, item, "film");
  } catch (e) {
    send(msg.chat.id, "❌ Video-ga lama diri karin.");
  }
});

/* SEARCH DRAMA */

bot.onText(/^\/drama(?:\s+(.+))?$/i, async (msg, match) => {
  const query = (match[1] || "").trim();

  if (!query) {
    return send(msg.chat.id, "Isticmaal: /drama MAGACA");
  }

  const item = db.dramas.find(d =>
    normalize(d.title) === normalize(query)
  );

  if (!item) {
    return send(msg.chat.id, "❌ Musalsalkan lama helin.");
  }

  try {
    await sendMedia(msg.chat.id, item, "drama");
  } catch (e) {
    send(msg.chat.id, "❌ Video-ga lama diri karin.");
  }
});

/* DELETE FILM */

bot.onText(/^\/deletefilm\s+(.+)$/i, msg => {
  if (!isAdmin(msg.from.id)) return send(msg.chat.id, "⛔ Admin kaliya.");

  const name = normalize(msg.text.replace(/^\/deletefilm\s+/i, ""));
  const old = db.films.length;

  db.films = db.films.filter(f => normalize(f.title) !== name);
  saveDB();

  send(msg.chat.id,
    old === db.films.length ? "❌ Filim lama helin." : "✅ Filim waa la tirtiray.");
});

/* DELETE DRAMA */

bot.onText(/^\/deletedrama\s+(.+)$/i, msg => {
  if (!isAdmin(msg.from.id)) return send(msg.chat.id, "⛔ Admin kaliya.");

  const name = normalize(msg.text.replace(/^\/deletedrama\s+/i, ""));
  const old = db.dramas.length;

  db.dramas = db.dramas.filter(d => normalize(d.title) !== name);
  saveDB();

  send(msg.chat.id,
    old === db.dramas.length ? "❌ Musalsal lama helin." : "✅ Musalsal waa la tirtiray.");
});

/* LIST USERS */

bot.onText(/^\/users$/, msg => {
  if (!isAdmin(msg.from.id)) return send(msg.chat.id, "⛔ Admin kaliya.");

  const list = db.users.slice(0, 50).map((u, i) =>
    `${i + 1}. ${u.name} - ${u.id}`
  ).join("\n");

  send(msg.chat.id,
    `👥 <b>USERS (${db.users.length})</b>\n\n${list || "Ma jiraan users."}`);
});

/* ADD ADMIN */

bot.onText(/^\/addadmin\s+(\d+)$/, msg => {
  if (String(msg.from.id) !== OWNER) {
    return send(msg.chat.id, "⛔ Owner kaliya.");
  }

  const id = msg.text.split(/\s+/)[1];

  if (!db.admins.includes(id)) {
    db.admins.push(id);
    saveDB();
  }

  send(msg.chat.id, "✅ Admin waa lagu daray: " + id);
});

/* REMOVE ADMIN */

bot.onText(/^\/deladmin\s+(\d+)$/, msg => {
  if (String(msg.from.id) !== OWNER) {
    return send(msg.chat.id, "⛔ Owner kaliya.");
  }

  const id = msg.text.split(/\s+/)[1];

  if (id === OWNER) {
    return send(msg.chat.id, "❌ Owner lama saari karo.");
  }

  db.admins = db.admins.filter(a => a !== id);
  saveDB();

  send(msg.chat.id, "✅ Admin waa laga saaray.");
});

/* STATISTICS */

bot.onText(/^\/stats$/, msg => {
  if (!isAdmin(msg.from.id)) return send(msg.chat.id, "⛔ Admin kaliya.");

  send(msg.chat.id,
    `📊 <b>QAANCIYE STATISTICS</b>

👥 Users: ${db.users.length}
🎬 Films: ${db.films.length}
📺 Dramas: ${db.dramas.length}
👑 Admins: ${db.admins.length}`);
});

/* BROADCAST */

bot.onText(/^\/broadcast\s+([\s\S]+)$/i, async (msg, match) => {
  if (!isAdmin(msg.from.id)) return send(msg.chat.id, "⛔ Admin kaliya.");

  const text = match[1].trim();

  if (!text) return send(msg.chat.id, "Isticmaal: /broadcast QORAAL");

  let sent = 0;
  let failed = 0;

  await send(msg.chat.id, "📢 Broadcast ayaa bilaabmaya...");

  for (const u of db.users) {
    try {
      await bot.sendMessage(u.id, text);
      sent++;
    } catch (e) {
      failed++;
    }

    await new Promise(resolve => setTimeout(resolve, 40));
  }

  send(msg.chat.id,
    `📢 <b>BROADCAST DHAMMAADAY</b>\n\n✅ Sent: ${sent}\n❌ Failed: ${failed}`);
});

/* ERROR HANDLER */

bot.on("polling_error", error => {
  console.error("Polling error:", error.message);
});

process.on("uncaughtException", error => {
  console.error("Application error:", error);
});

console.log("QAANCIYE FILM BOT PRO is running!");
