const TelegramBot = require("node-telegram-bot-api");
const fs = require("fs");
const path = require("path");

const TOKEN = process.env.9111277427:AAGWDI3sauGzZLykWrcBu4DA2-hIKKEoJ-A;
const OWNER = "6714164629";
const CHANNEL = "@Qaanciye";
const SUPPORT = "@Mrbosstiger";

if (!TOKEN) {
  throw new Error("9111277427:AAGWDI3sauGzZLykWrcBu4DA2-hIKKEoJ-A");
}

const bot = new TelegramBot(TOKEN, { polling: true });
const DB_FILE = path.join(__dirname, "database.json");

let db = {
  films: [],
  dramas: [],
  users: [],
  admins: [OWNER]
};

function loadDB() {
  try {
    if (fs.existsSync(DB_FILE)) {
      const saved = JSON.parse(fs.readFileSync(DB_FILE, "utf8"));
      for (const key of ["films", "dramas", "users", "admins"]) {
        if (Array.isArray(saved[key])) db[key] = saved[key];
      }
    }
  } catch (e) {
    console.error("Database error:", e.message);
  }

  if (!db.admins.includes(OWNER)) db.admins.push(OWNER);
}

function saveDB() {
  const temp = DB_FILE + ".tmp";
  fs.writeFileSync(temp, JSON.stringify(db, null, 2));
  fs.renameSync(temp, DB_FILE);
}

loadDB();

const waiting = new Map();

function isAdmin(id) {
  return db.admins.includes(String(id));
}

function send(id, text) {
  return bot.sendMessage(id, text, { parse_mode: "HTML" });
}

function normalize(value) {
  return String(value || "")
    .toLowerCase()
    .normalize("NFKC")
    .replace(/[^\p{L}\p{N}]/gu, "");
}

function addUser(user) {
  const id = String(user.id);
  let old = db.users.find(u => String(u.id) === id);

  if (old) {
    old.name = user.first_name || old.name;
    old.username = user.username || old.username;
  } else {
    db.users.push({
      id,
      name: user.first_name || "User",
      username: user.username || "",
      joined: new Date().toISOString()
    });
  }
  saveDB();
}

