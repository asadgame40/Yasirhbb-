async function sendMedia(chatId, item, type) {
  return bot.sendVideo(chatId, item.file_id, {
    caption:
      `${type === "film" ? "🎬" : "📺"} ${item.title}\n\n` +
      `QAANCIYE FILM BOT PRO\n${CHANNEL}`,
    protect_content: true
  });
}

bot.onText(/^\/start$/, msg => {
  addUser(msg.from);
  send(msg.chat.id, menu());
});

bot.onText(/^\/register$/, msg => {
  addUser(msg.from);
  send(msg.chat.id, "✅ Waad ka diiwaangashan tahay QAANCIYE FILM BOT PRO.");
});

bot.onText(/^\/admin$/, msg => {
  if (!isAdmin(msg.from.id)) {
    return send(msg.chat.id, "⛔ Admin kaliya.");
  }
  send(msg.chat.id, adminPanel());
});

bot.onText(/^\/cancel$/, msg => {
  waiting.delete(String(msg.from.id));
  send(msg.chat.id, "❌ Hawsha waa la joojiyay.");
});

bot.onText(/^\/addfilm$/, msg => {
  if (!isAdmin(msg.from.id)) return send(msg.chat.id, "⛔ Admin kaliya.");
  waiting.set(String(msg.from.id), "film");
  send(msg.chat.id, "🎬 Soo dir video-ga filimka. Caption-ka ku qor magaca.");
});

bot.onText(/^\/adddrama$/, msg => {
  if (!isAdmin(msg.from.id)) return send(msg.chat.id, "⛔ Admin kaliya.");
  waiting.set(String(msg.from.id), "drama");
  send(msg.chat.id, "📺 Soo dir video-ga musalsalka. Caption-ka ku qor magaca.");
});

bot.on("message", async msg => {
  if (!msg.from) return;

  addUser(msg.from);

  const id = String(msg.from.id);
  const task = waiting.get(id);

  if (!task || !isAdmin(id) || !msg.video) return;

  const title = String(msg.caption || "").trim();
  if (!title) return send(msg.chat.id, "❌ Caption-ka ku qor magaca.");

  const list = task === "film" ? db.films : db.dramas;

  list.push({
    title,
    file_id: msg.video.file_id,
    added_by: id,
    date: new Date().toISOString()
  });

  saveDB();
  waiting.delete(id);

  send(msg.chat.id, `✅ Waa la kaydiyey!\n\n🎬 ${title}`);
});

bot.onText(/^\/films$/, msg => {
  const text = db.films.map((f, i) => `${i + 1}. ${f.title}`).join("\n");
  send(msg.chat.id, "🎬 <b>FILMS</b>\n\n" + (text || "Filim lama hayo."));
});

bot.onText(/^\/dramas$/, msg => {
  const text = db.dramas.map((d, i) => `${i + 1}. ${d.title}`).join("\n");
  send(msg.chat.id, "📺 <b>DRAMAS</b>\n\n" + (text || "Musalsal lama hayo."));
});

bot.onText(/^\/movie(?:\s+(.+))?$/i, async (msg, match) => {
  const query = (match[1] || "").trim();
  if (!query) return send(msg.chat.id, "Isticmaal: /movie MAGACA");

  const item = db.films.find(f => normalize(f.title) === normalize(query));
  if (!item) return send(msg.chat.id, "❌ Filimkan lama helin.");

  try {
    await sendMedia(msg.chat.id, item, "film");
  } catch (e) {
    console.error(e.message);
    send(msg.chat.id, "❌ Video-ga lama diri karin.");
  }
});

bot.onText(/^\/drama(?:\s+(.+))?$/i, async (msg, match) => {
  const query = (match[1] || "").trim();
  if (!query) return send(msg.chat.id, "Isticmaal: /drama MAGACA");

  const item = db.dramas.find(d => normalize(d.title) === normalize(query));
  if (!item) return send(msg.chat.id, "❌ Musalsalkan lama helin.");

  try {
    await sendMedia(msg.chat.id, item, "drama");
  } catch (e) {
    console.error(e.message);
    send(msg.chat.id, "❌ Video-ga lama diri karin.");
  }
});

bot.onText(/^\/deletefilm\s+(.+)$/i, msg => {
  if (!isAdmin(msg.from.id)) return send(msg.chat.id, "⛔ Admin kaliya.");

  const name = normalize(msg.text.replace(/^\/deletefilm\s+/i, ""));
  const old = db.films.length;
  db.films = db.films.filter(f => normalize(f.title) !== name);
  saveDB();

  send(msg.chat.id, old === db.films.length ? "❌ Lama helin." : "✅ Filim waa la tirtiray.");
});

bot.onText(/^\/deletedrama\s+(.+)$/i, msg => {
  if (!isAdmin(msg.from.id)) return send(msg.chat.id, "⛔ Admin kaliya.");

  const name = normalize(msg.text.replace(/^\/deletedrama\s+/i, ""));
  const old = db.dramas.length;
  db.dramas = db.dramas.filter(d => normalize(d.title) !== name);
  saveDB();

  send(msg.chat.id, old === db.dramas.length ? "❌ Lama helin." : "✅ Musalsal waa la tirtiray.");
});

bot.onText(/^\/users$/, msg => {
  if (!isAdmin(msg.from.id)) return send(msg.chat.id, "⛔ Admin kaliya.");

  const text = db.users.slice(0, 50)
    .map((u, i) => `${i + 1}. ${u.name} - ${u.id}`)
    .join("\n");

  send(msg.chat.id, `👥 USERS: ${db.users.length}\n\n${text || "Ma jiraan users."}`);
});

bot.onText(/^\/addadmin\s+(\d+)$/, msg => {
  if (String(msg.from.id) !== OWNER) return send(msg.chat.id, "⛔ Owner kaliya.");

  const id = msg.text.split(/\s+/)[1];
  if (!db.admins.includes(id)) {
    db.admins.push(id);
    saveDB();
  }
  send(msg.chat.id, "✅ Admin waa lagu daray: " + id);
});

bot.onText(/^\/deladmin\s+(\d+)$/, msg => {
  if (String(msg.from.id) !== OWNER) return send(msg.chat.id, "⛔ Owner kaliya.");

  const id = msg.text.split(/\s+/)[1];
  if (id === OWNER) return send(msg.chat.id, "❌ Owner lama saari karo.");

  db.admins = db.admins.filter(a => a !== id);
  saveDB();
  send(msg.chat.id, "✅ Admin waa laga saaray.");
});

bot.onText(/^\/listfilms$/, msg => {
  if (!isAdmin(msg.from.id)) return send(msg.chat.id, "⛔ Admin kaliya.");
  send(msg.chat.id, db.films.map((f, i) => `${i + 1}. ${f.title}`).join("\n") || "Filim ma jiro.");
});

bot.onText(/^\/listdramas$/, msg => {
  if (!isAdmin(msg.from.id)) return send(msg.chat.id, "⛔ Admin kaliya.");
  send(msg.chat.id, db.dramas.map((d, i) => `${i + 1}. ${d.title}`).join("\n") || "Musalsal ma jiro.");
});

bot.onText(/^\/stats$/, msg => {
  if (!isAdmin(msg.from.id)) return send(msg.chat.id, "⛔ Admin kaliya.");

  send(msg.chat.id, `📊 <b>QAANCIYE STATISTICS</b>

👥 Users: ${db.users.length}
🎬 Films: ${db.films.length}
📺 Dramas: ${db.dramas.length}
👑 Admins: ${db.admins.length}`);
});

bot.onText(/^\/broadcast\s+([\s\S]+)$/i, async (msg, match) => {
  if (!isAdmin(msg.from.id)) return send(msg.chat.id, "⛔ Admin kaliya.");

  const text = match[1].trim();
  let sent = 0;
  let failed = 0;

  await send(msg.chat.id, "📢 Broadcast ayaa bilaabmaya...");

  for (const user of db.users) {
    try {
      await bot.sendMessage(user.id, text);
      sent++;
    } catch (e) {
      failed++;
    }
    await new Promise(resolve => setTimeout(resolve, 40));
  }

  send(msg.chat.id, `📢 <b>BROADCAST DHAMMAADAY</b>\n\n✅ Sent: ${sent}\n❌ Failed: ${failed}`);
});

bot.on("polling_error", error => console.error("Polling:", error.message));
bot.on("error", error => console.error("Bot:", error.message));

